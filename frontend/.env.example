# Server only, never VITE_: the same value as PROXY_SECRET in the backend. Lets share and profile pages give each
# visitor their own rate limit. Generate with: openssl rand -hex 32. Empty: all visitors share one limit.
PROXY_SECRET=
# Backend API base URL
# Production: https://api.shortlist.co.in
VITE_API_URL=http://localhost:4000
# Public URL of this frontend, used for share links and metadata
# Production: https://shortlist.co.in
VITE_SITE_URL=http://localhost:3000
# Show "Continue as guest" on the sign-in page. Unset: shown in development only.
VITE_ENABLE_GUEST_LOGIN=
# Show "Continue with ChatGPT". Leave empty until OpenAI gives you a client (partner-only beta).
VITE_ENABLE_CHATGPT_LOGIN=
# PostHog (Settings > Project > General): the public project token and your region's host. Empty: no analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
